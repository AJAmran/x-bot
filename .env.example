# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in your key.
# `.env*` is gitignored, so your real key is never committed.
# ---------------------------------------------------------------------------

# Google Gemini API key — https://aistudio.google.com/apikey
#
# OPTIONAL. With no key the app still runs in full "demo mode": the menu, cart,
# map, checkout, payment and the local intent layer all work, and the chat shows
# an "AI temporarily unavailable" banner. Only the conversational waiter is
# unavailable. This makes the deployed demo safe to share without leaking a key.
#
# Free tier: see "Known Limitations" in the README for the request ceiling and
# where to check your own quota.
GEMINI_API_KEY=

# NOTE: this value is read at BUILD time (the pages are statically prerendered).
# After adding or changing the key on Vercel you must REDEPLOY, not just restart.

# ---------------------------------------------------------------------------
# Telegram — sends a placed order to the kitchen's chat.
# ---------------------------------------------------------------------------
#
# OPTIONAL. With neither value set, ordering works exactly as before and the
# notification is simply skipped.
#
#   TELEGRAM_BOT_TOKEN  from @BotFather
#   TELEGRAM_CHAT_ID    the chat to post into. For a group, add the bot to it and
#                       use the group's id (often negative, e.g. -1001234567890).
#
# SECURITY: the token is a credential. It is read only inside the server route
# `app/api/order-notify/route.ts` and must never be exposed to the browser —
# do NOT rename it with a NEXT_PUBLIC_ prefix, or it ships to every visitor and
# anyone can post into your chat as the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ---------------------------------------------------------------------------
# Test-only
# ---------------------------------------------------------------------------
#
# Guards `app/api/test-telegram`, a manual smoke test that posts a real message
# to the kitchen chat. LEAVE THIS UNSET IN PRODUCTION: with no value the route
# answers 404, so there is nothing to find. Only set it locally, and only to run
# the test yourself:
#
#   curl -H "x-telegram-test-secret: $TELEGRAM_TEST_SECRET" \
#        https://your-domain.com/api/test-telegram
#
# Without the guard this was a public GET that anyone could trigger, which is
# why it is opt-in rather than merely undocumented.
TELEGRAM_TEST_SECRET=